# MemOrg AI - Environment Variables

# OpenAI API Key (Required for embeddings; also used as LLM when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai

# OpenAI LLM model (used when LLM_PROVIDER=openai)
LLM_MODEL=gpt-4-turbo-preview

# Anthropic API Key and model (used when LLM_PROVIDER=anthropic)
# Supported models: claude-sonnet-4-5, claude-opus-4-5, etc.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Confluence Settings (Optional)
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your_email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token

# Slack Settings (Optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Vector Database Settings
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
